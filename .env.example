# 실제 값은 .env.local에 넣고 커밋하지 않는다. 이 파일에는 이름과 용도만 적는다.

# Supabase 공개 설정 (브라우저에 포함되어도 되는 값)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 기존 anon key를 쓰는 경우 위 대신 사용할 수 있다.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase 서버 전용 키. 결제 확정, 풀이 저장, 질문 차감에만 쓴다. NEXT_PUBLIC_을 붙이지 않는다.
SUPABASE_SECRET_KEY=
# 기존 service_role 키를 쓰는 경우 위 대신 사용할 수 있다.
# SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (서버 전용)
OPENAI_API_KEY=
# 개발: gpt-5.6-luna / 출시 전 검증을 마친 뒤: gpt-6-luna
OPENAI_MODEL=gpt-5.6-luna

# 이용 방식 (서버 전용). 비워 두면 free_trial이다.
#   free_trial: 카카오 회원에게 무료 이용권 1장을 지급하고 이용권으로만 풀이를 받는다. 새 결제는 서버에서 막고 토스 키가 없어도 된다.
#   payment:    기존 토스페이먼츠 결제를 다시 연다. 새 무료 지급은 멈추고, 이미 받은 이용권과 풀이 권한은 그대로 쓴다.
# 로그인은 모드와 관계없이 카카오만 지원한다 (Supabase Authentication > Sign In / Providers에서도 카카오만 켠다).
# CHECKOUT_MODE=free_trial

# 토스페이먼츠 테스트 키 (test_gck_ / test_gsk_). CHECKOUT_MODE=payment일 때만 필요하다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 실제 과금으로 전환할 때만 true로 설정한다. 기본은 테스트 키만 허용한다. 결제 모드로 바꾸는 것만으로 실결제가 되지 않는다.
# PAYMENTS_ALLOW_LIVE=true

# 프록시 뒤에서 주소를 고정하고 싶을 때만 설정한다. 예: https://example.com
# APP_ORIGIN=
