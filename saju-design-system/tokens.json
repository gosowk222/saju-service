{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "사주풀이 디자인 시스템",
  "version": "1.3.0",
  "updated": "2026-11-09",
  "description": "구조는 instagram.com 추출 토큰, 화면 문법은 유료 사주 서비스 3곳(사주타이트·청월당·사주키드) 벤치마크, 색은 참고 레이아웃(12화면 흐름)에서 추출한 보라·라벤더 팔레트. 타깃 20~30대, 무료+유료(유료 중심).",

  "color": {
    "primary": {
      "50":  { "$value": "#F3F1FD", "$description": "선택 배경, 말풍선 강조면" },
      "100": { "$value": "#E6E2FB", "$description": "포커스 링 외곽, 톤 버튼 바탕, 칩" },
      "200": { "$value": "#CFC7F7", "$description": "비활성 보라" },
      "300": { "$value": "#B3A6F3", "$description": "차트 보조, 테두리" },
      "400": { "$value": "#9D8DF8", "$description": "그라데이션 밝은 끝 (참고안 추출)" },
      "500": { "$value": "#8B7CF6", "$description": "브랜드 원색 (참고안 추출). 흰 글자와 3.3:1 — 아이콘·큰 글자·면 전용, 버튼 금지" },
      "600": { "$value": "#6E5CE6", "$description": "★ 버튼·링크·포커스·선택 상태. 흰 글자와 4.8:1" },
      "700": { "$value": "#5748C4", "$description": "hover · pressed · 링크 hover" },
      "900": { "$value": "#2B2457", "$description": "밤 히어로 배경, 포스터 플레이스홀더 톤 (참고안 추출)" }
    },
    "gray": {
      "white": { "$value": "#FFFFFF", "$description": "카드 면" },
      "50":  { "$value": "#F7F6FC", "$description": "페이지·섹션 바탕" },
      "100": { "$value": "#ECEAF5", "$description": "칩·비활성·풀이 말풍선 (참고안 라벤더 #EFEDFB)" },
      "200": { "$value": "#DCD9EA", "$description": "카드 테두리, 구분선" },
      "300": { "$value": "#C9C6DC", "$description": "입력 테두리" },
      "400": { "$value": "#A9A6C0", "$description": "셰브런, 범례 점, 비활성 아이콘 — 글자 금지" },
      "500": { "$value": "#716D8E", "$description": "보조 글자 (4.9:1) — 金 오행 글자 겸용" },
      "600": { "$value": "#625E80", "$description": "캡션·라벨 글자 (6.1:1)" },
      "700": { "$value": "#4A4668", "$description": "설명 글자" },
      "800": { "$value": "#322E52", "$description": "토스트 바탕" },
      "900": { "$value": "#262345", "$description": "본문·제목 글자 (참고안 #2D2A4A)" }
    },
    "rose": {
      "50":  { "$value": "#FDE8EF" },
      "400": { "$value": "#F28BB3", "$description": "참고안 추출 — 연애 아이콘 원색" },
      "600": { "$value": "#C2366B", "$description": "★ 글자·배지 바탕 (5.2:1). 연애 분야 · danger · 할인/인기 배지 · 흉(凶)" }
    },
    "gold": {
      "50":  { "$value": "#FFF4D6" },
      "300": { "$value": "#F7D98A" },
      "400": { "$value": "#F2B544", "$description": "참고안 추출 — 재물 아이콘, 이용권 코인 면 (위 글자 #4A3200)" },
      "700": { "$value": "#9A6700", "$description": "★ 글자 (4.9:1). 재물 분야 · 土 · warning · 유료 배지 · 대길" },
      "800": { "$value": "#5C3D00" }
    },
    "blue": {
      "50":  { "$value": "#E3EEFC" },
      "400": { "$value": "#6FA8F0", "$description": "참고안 추출 — 직업 아이콘 원색" },
      "600": { "$value": "#2B63C6", "$description": "★ 글자 (5.7:1). 직업 분야 · 水" },
      "900": { "$value": "#1E4A9A" }
    },
    "green": {
      "50":  { "$value": "#E1F5EE" },
      "400": { "$value": "#5CC0A0", "$description": "참고안 민트 — 범례 점" },
      "600": { "$value": "#257F60", "$description": "★ 글자·배지 바탕 (4.9:1). 궁합 분야 · 木 · success · 무료 배지 · 길(吉)" }
    },
    "orange": {
      "50":  { "$value": "#FFEBD9" },
      "400": { "$value": "#F39A4A", "$description": "참고안 추출 — 오늘/인생 아이콘 원색" },
      "600": { "$value": "#B55A12", "$description": "★ 글자 (4.8:1). 인생 분야 · 火" }
    },
    "fixed": {
      "kakao":        { "$value": "#FEE500", "$description": "카카오 로그인 버튼 고정값 — 토큰으로 재사용 금지" },
      "kakao-text":   { "$value": "#191600" },
      "on-gold":      { "$value": "#4A3200", "$description": "gold-400 위 글자" },
      "on-image":     { "$value": "#FFFFFF", "$description": "포스터 위 제목" },
      "on-image-muted": { "$value": "rgba(255,255,255,0.72)", "$description": "포스터 위 부제" },
      "scrim":        { "$value": "linear-gradient(to top, rgba(0,0,0,0.72), rgba(0,0,0,0) 60%)", "$description": "포스터 하단 스크림 — 농도 72% 이하로 내리지 않음" },
      "gradient-primary": { "$value": "linear-gradient(135deg, #9D8DF8, #6E5CE6)", "$description": "오늘의 운세 배너·히어로 CTA에만" },
      "shadow-float": { "$value": "0 4px 16px rgba(38,35,69,0.08)", "$description": "바텀시트·툴팁 전용. 카드는 그림자 없이 1px 테두리" }
    },
    "semantic": {
      "action":        { "$value": "{color.primary.600}", "$description": "버튼·링크·선택 탭·활성 아이콘" },
      "action-hover":  { "$value": "{color.primary.700}" },
      "action-tonal":  { "$value": "{color.primary.100}", "$description": "보조 버튼 바탕 (글자 primary.600)" },
      "focus-ring":    { "$value": "{color.primary.600}", "$description": "2px + {color.primary.100} 3px 외곽" },
      "text":          { "$value": "{color.gray.900}" },
      "text-secondary":{ "$value": "{color.gray.700}" },
      "text-muted":    { "$value": "{color.gray.500}" },
      "surface":       { "$value": "{color.gray.white}" },
      "surface-page":  { "$value": "{color.gray.50}" },
      "surface-muted": { "$value": "{color.gray.100}" },
      "border":        { "$value": "{color.gray.200}" },
      "border-input":  { "$value": "{color.gray.300}" },
      "success":       { "$value": "{color.green.600}", "tint": "{color.green.50}" },
      "warning":       { "$value": "{color.gold.700}",  "tint": "{color.gold.50}" },
      "danger":        { "$value": "{color.rose.600}",  "tint": "{color.rose.50}" },
      "info":          { "$value": "{color.primary.600}", "tint": "{color.primary.50}" },
      "chat-assistant":{ "$value": "{color.gray.100}", "$description": "풀이 말풍선 바탕, 글자 gray.900, radius 16/16/16/4" },
      "chat-user":     { "$value": "{color.primary.600}", "$description": "내 말풍선 바탕, 글자 white, radius 16/16/4/16" }
    },
    "category": {
      "$description": "분야색 = 오행 틴트. 글자는 -600/-700, 바탕은 -50, 점·아이콘 원색은 -400",
      "love":      { "label": "연애", "text": "{color.rose.600}",   "tint": "{color.rose.50}",   "dot": "{color.rose.400}" },
      "wealth":    { "label": "재물 · 土", "text": "{color.gold.700}", "tint": "{color.gold.50}", "dot": "{color.gold.400}" },
      "career":    { "label": "직업 · 水", "text": "{color.blue.600}", "tint": "{color.blue.50}", "dot": "{color.blue.400}" },
      "match":     { "label": "궁합 · 木", "text": "{color.green.600}", "tint": "{color.green.50}", "dot": "{color.green.400}" },
      "life":      { "label": "인생 · 火", "text": "{color.orange.600}", "tint": "{color.orange.50}", "dot": "{color.orange.400}" },
      "character": { "label": "성격 · 金", "text": "{color.gray.500}", "tint": "{color.gray.100}", "dot": "{color.gray.400}" },
      "today":     { "label": "오늘", "text": "{color.primary.600}", "tint": "{color.primary.50}", "dot": "{color.primary.500}" },
      "all":       { "label": "전체", "text": "{color.gray.900}", "tint": "{color.gray.white}", "border": "{color.gray.200}" }
    },
    "ohaeng": {
      "$description": "명식 칸(천간·지지) 색. 분야색과 동일 값",
      "wood":  { "label": "木", "text": "{color.green.600}",  "tint": "{color.green.50}" },
      "fire":  { "label": "火", "text": "{color.orange.600}", "tint": "{color.orange.50}" },
      "earth": { "label": "土", "text": "{color.gold.700}",   "tint": "{color.gold.50}" },
      "metal": { "label": "金", "text": "{color.gray.500}",   "tint": "{color.gray.100}" },
      "water": { "label": "水", "text": "{color.blue.600}",   "tint": "{color.blue.50}" }
    },
    "badge": {
      "paid":     { "bg": "{color.gold.50}",    "text": "{color.gold.700}",   "label": "유료 · 가격" },
      "free":     { "bg": "{color.green.50}",   "text": "{color.green.600}",  "label": "무료" },
      "discount": { "bg": "{color.rose.50}",    "text": "{color.rose.600}",   "label": "-30% · 인기" },
      "progress": { "bg": "{color.primary.100}","text": "{color.primary.600}","label": "이어보기 3/7 · 진행중" },
      "new":      { "bg": "{color.primary.600}","text": "{color.gray.white}", "label": "NEW" },
      "done":     { "bg": "{color.gray.100}",   "text": "{color.gray.700}",   "label": "구매 완료" },
      "lucky":    { "bg": "{color.green.600}",  "text": "{color.gray.white}", "label": "길 吉" },
      "unlucky":  { "bg": "{color.rose.600}",   "text": "{color.gray.white}", "label": "흉 凶" },
      "great":    { "bg": "{color.gold.700}",   "text": "{color.gray.white}", "label": "대길 大吉" }
    }
  },

  "typography": {
    "family": {
      "sans":  { "$value": "'Noto Sans KR', 'Pretendard', -apple-system, system-ui, sans-serif", "$description": "UI·본문·숫자. Pretendard로 교체해도 토큰 불변" },
      "serif": { "$value": "'Noto Serif KR', 'Nanum Myeongjo', serif", "$description": "display · heading-1 · 천간지지 한자 · 포스터 위 제목" },
      "mono":  { "$value": "ui-monospace, SFMono-Regular, Menlo, monospace" }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "$description": "Sans는 400/500/600, 700은 가격·숫자 강조에만. Serif는 500/700" },
    "scale": {
      "display":    { "family": "serif", "size": 44, "lineHeight": 52, "weight": 700, "letterSpacing": "-0.01em" },
      "heading-1":  { "family": "serif", "size": 32, "lineHeight": 40, "weight": 700 },
      "heading-2":  { "family": "sans",  "size": 24, "lineHeight": 32, "weight": 600 },
      "heading-3":  { "family": "sans",  "size": 20, "lineHeight": 28, "weight": 600 },
      "title":      { "family": "sans",  "size": 18, "lineHeight": 26, "weight": 600, "$description": "화면 섹션 제목" },
      "body-lg":    { "family": "sans",  "size": 17, "lineHeight": 26, "weight": 400 },
      "body":       { "family": "sans",  "size": 15, "lineHeight": 22, "weight": 400 },
      "label":      { "family": "sans",  "size": 14, "lineHeight": 20, "weight": 500 },
      "caption":    { "family": "sans",  "size": 12, "lineHeight": 16, "weight": 400 },
      "caption-sm": { "family": "sans",  "size": 11, "lineHeight": 14, "weight": 500, "$description": "배지·탭 라벨만. 10px 금지" },
      "hanja":      { "family": "serif", "size": 28, "lineHeight": 1, "weight": 500, "letterSpacing": "0.02em", "$description": "천간·지지 한 글자, 48px 이상 틴트 칸 위" },
      "poster-title": { "family": "serif", "size": 22, "lineHeight": 1.15, "weight": 700, "color": "#FFFFFF", "$description": "포스터 카드 위 제목, 히어로는 40px" },
      "price":      { "family": "sans",  "size": 14, "weight": 700, "fontVariantNumeric": "tabular-nums", "$description": "정가 취소선은 gray-500 400" }
    }
  },

  "spacing": {
    "1": 2, "2": 4, "3": 8, "4": 12, "5": 16, "6": 20, "7": 24, "8": 32, "9": 40, "10": 52, "11": 120,
    "$description": "4px 격자. 카드 안쪽 16, 카드 사이 12, 섹션 사이 40, 화면 좌우 16(모바일)/20(이상), 버튼·탭 높이 44"
  },

  "radius": {
    "sm": 8, "md": 12, "lg": 16, "pill": 22, "xl": 24, "full": 9999,
    "$description": "sm 배지·스와치 / md 포스터 이미지·한자 칸·소셜 버튼 / lg 카드·입력 / pill 44px 버튼·칩 / xl 바텀시트·히어로 포스터 / full 아바타·점"
  },

  "size": {
    "button": 44, "button-lg": 52, "button-sm": 36, "chip": 36, "input": 52, "tab-bar": 56, "header": 56,
    "category-tile": 56, "hanja-cell": 56, "poster-ratio": "3:4", "touch-min": 44
  },

  "motion": {
    "duration": { "fast": "150ms", "base": "200ms", "slow": "300ms" },
    "easing": { "standard": "cubic-bezier(0.4, 0, 0.2, 1)", "exit": "cubic-bezier(0.4, 0, 1, 1)" },
    "$description": "fast 버튼·링크·입력 상태, base 모달·탭·카드 펼침, slow 바텀시트·결과 드러남·캐러셀 스냅. 마키·무한 핑 금지. prefers-reduced-motion에서 0ms"
  },

  "layout": {
    "breakpoints": { "compact": 375, "medium": 480, "desktop": 768, "wide": 1024, "xwide": 1280, "max": 1440 },
    "content-max-width": 600,
    "side-gutter": { "compact": 16, "medium": 20 },
    "poster-grid": "repeat(auto-fill, minmax(150px, 1fr))",
    "$description": "데스크톱에서도 중앙 단일 컬럼(max 600px), 바깥은 gray-50. 사이드 내비 없음. 하단 탭 4개: 홈·탐색·보관함·마이"
  },

  "icon": { "system": "Lucide", "stroke": 2, "size": { "tab": 22, "inline": 18, "tile": 24 }, "$description": "이모지 금지. 아이콘 단독 버튼에는 aria-label" }
}
